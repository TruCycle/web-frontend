{
  "name": "trucycle-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "build:staging": "node scripts/build-staging.mjs",
    "test:staging": "node --test scripts/build-staging.test.mjs scripts/staging-vision.test.mjs",
    "test:consent": "node --test scripts/analytics-consent.test.mjs",
    "test:session": "node --test scripts/session-recovery.test.mjs",
    "test:socket": "node --test scripts/websocket-auth.test.mjs",
    "test:messaging": "node --test scripts/messaging-delivery.test.mjs scripts/messaging-room-state.test.mjs scripts/messaging-history.test.mjs",
    "test:seo": "node --test scripts/seo.test.mjs",
    "test:shops": "node --test scripts/shops-contract.test.mjs",
    "test:location": "node --test scripts/found-location-privacy.test.mjs scripts/items-location-privacy.test.mjs",
    "build:prerender": "npm run build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@posthog/react": "^1.10.1",
    "canvas-confetti": "^1.9.4",
    "html-to-image": "^1.11.13",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.574.0",
    "posthog-js": "^1.386.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.26",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "puppeteer": "^25.10.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
